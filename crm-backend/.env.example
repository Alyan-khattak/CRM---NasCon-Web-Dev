# App
APP_ENV=development           # development | production
SECRET_KEY=change-me-to-32-random-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Database
DB_MODE=sqlite                # sqlite | supabase
SUPABASE_URL=https://hqmsxkqipzrxqtjceezd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=              # postgresql+asyncpg://postgres:[password]@[host]:5432/postgres
SQLITE_PATH=./local_test.db   # only used when DB_MODE=sqlite

# Retell AI
RETELL_API_KEY=
RETELL_FROM_NUMBER=           # your Retell phone number
RETELL_WEBHOOK_SECRET=        # for signature verification

# Simpaisa Payments
SIMPAISA_API_KEY=
SIMPAISA_BASE_URL=https://sandbox.simpaisa.com
SIMPAISA_WEBHOOK_SECRET=      # for signature verification

# Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute
